{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_appName__",
  "version": "1.0.0",
  "description": "__MSG_shortDesc__",
  "author": "Maksim Bugai",
  "homepage_url": "https://secure.fileshare.ovh/secret-message.html",
  "minimum_chrome_version": "102",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*",
        "https://*.messenger.com/*",
        "https://vk.com/*",
        "https://*.vk.com/*",
        "https://vk.ru/*",
        "https://*.vk.ru/*",
        "https://web.telegram.org/*"
      ],
      "js": [
        "js/lib/secret-message-env.js",
        "js/lib/jszip.min.js",
        "js/lib/security-utils.js",
        "js/lib/secret-message.js",
        "js/lib/secret-message-settings.js",
        "js/sites/sites.js",
        "js/sites/facebook.js",
        "js/sites/vk.js",
        "js/sites/telegram.js",
        "js/hover-decoder.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "MacCtrl+Shift+Y"
      },
      "description": "__MSG_commandDesc__"
    },
    "toggle-auto-decoding": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "MacCtrl+Shift+L"
      },
      "description": "__MSG_autoDecodingCommandDesc__"
    },
    "convert-focused-text": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "MacCtrl+Shift+E"
      },
      "description": "__MSG_convertCommandDesc__"
    }
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "css/secret-message-widget.css"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
